# smoke_test_3.ofn — enum codegen smoke test (PR #46).
#
# Covers:
#   Unit variant construction + match
#   Qualified unit variant construction (Dir.South)
#   Single-field tuple variant payload binding
#   Two-field tuple variant payload binding (Rect(w,h))
#   Wildcard arm
#   Or-pattern (North | South => 0, East | West => 1)
#   Guarded arms with guard passing, failing, and all-failing → wildcard
#   Match as value-producing expression in arithmetic
#   Bool match subject
#   Enum passed to function, matched inside callee
#
# No I/O. Correctness proven by main's return value = checksum.
# Predicted exit code: 296 % 256 = 40

enum Dir   { North, South, East, West }
enum Shape { Circle(f64), Rect(i32, i32) }
enum Opt   { Some(i32), None }
copy enum Light { On, Off }
copy enum Color { Red, Green, Blue }

fn brightness(l: Light) -> i32 {
    match l { On => 100, Off => 0 }
}

fn axis(d: Dir) -> i32 {
    match d {
        North | South => 0,
        East  | West  => 1,
    }
}

fn classify(o: Opt) -> i32 {
    match o {
        Some(x) if x > 0 =>  1,
        Some(_)          =>  0,
        None             => -1,
    }
}

fn area(s: Shape) -> i32 {
    match s {
        Circle(r)    => if r > 0.0 { 1 } else { 0 },
        Rect(w, h)   => w * h,
    }
}

fn main() -> i32 {

    # -- A: unit variant + basic match ------------------------------------------
    let a = match North {
        North => 10,
        South => 20,
        East  => 30,
        West  => 40,
    };
    # a = 10

    # -- B: qualified unit variant -----------------------------------------------
    let b = match Dir.South {
        North => 0,
        South => 7,
        East  => 0,
        West  => 0,
    };
    # b = 7

    # -- C: single-field tuple variant payload binding ---------------------------
    let s = Circle(4.0);
    let c = match s {
        Circle(r)  => if r > 3.0 { 5 } else { 0 },
        Rect(w, h) => w * h,
    };
    # c = 5

    # -- D: wildcard arm ---------------------------------------------------------
    let d = match None {
        Some(x) => x,
        None    => 99,
    };
    # d = 99

    # -- E: or-pattern -----------------------------------------------------------
    let e = axis(North) + axis(South) + axis(East) + axis(West);
    # 0 + 0 + 1 + 1 = 2

    # -- F: guarded arms (pass, fail, never-reached) -----------------------------
    let f = classify(Some(5)) + classify(Some(-3)) + classify(None);
    # 1 + 0 + (-1) = 0

    # -- G: match as value-producing expression in arithmetic -------------------
    let g = 10 + match Green {
        Red   => 1,
        Green => 5,
        Blue  => 10,
    };
    # 10 + 5 = 15

    # -- H: enum passed to function, matched inside callee ----------------------
    let h = brightness(On) - brightness(Off);
    # 100 - 0 = 100

    # -- I: all guards fail → wildcard fires ------------------------------------
    let o = Some(-5);
    let i_val = match o {
        Some(x) if x > 0 => 1,
        _                => 42,
    };
    # 42

    # -- J: bool match subject ---------------------------------------------------
    let j = match true  { true => 1, false => 0 }
           + match false { true => 10, false => 3 };
    # 1 + 3 = 4

    # -- K: two-field tuple variant payload binding ------------------------------
    let k = area(Rect(3, 4));
    # 3 * 4 = 12

    # -- Checksum ----------------------------------------------------------------
    # a=10  b=7  c=5  d=99  e=2  f=0  g=15  h=100  i=42  j=4  k=12
    # sum = 296   exit = 296 % 256 = 40
    return a + b + c + d + e + f + g + h + i_val + j + k;
}
